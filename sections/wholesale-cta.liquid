<section class="wholesale-cta" data-section-id="{{ section.id }}" data-section-type="wholesale-cta">
  <div class="wholesale-cta__bg">
    {%- if section.settings.background != blank -%}
      {{
        section.settings.background
        | image_url: width: 1800
        | image_tag: loading: 'lazy', alt: ''
      }}
    {%- endif -%}
  </div>
  <div class="wholesale-cta__glow" aria-hidden="true"></div>

  <div class="wholesale-cta__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2 wholesale-cta__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="wholesale-cta__copy h4">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="wholesale-cta__link">
        {{ section.settings.link_label | default: 'Start your wholesale order' }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Wholesale CTA",
  "settings": [
    {
      "type": "image_picker",
      "id": "background",
      "label": "Background photo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brew beyond your cup."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>For homes, offices, or cafés that share our obsession with craft coffee — explore our subscription and wholesale programs.</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Start your wholesale order"
    }
  ],
  "presets": [
    {
      "name": "Wholesale CTA"
    }
  ]
}
{% endschema %}
