{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}

<section class="carousel-section" data-section-id="{{ section.id }}" data-section-type="featured-collection-carousel">
  <div class="carousel-section__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2 visually-hidden">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if collection != blank -%}
      <a href="{{ collection.url }}" class="carousel-section__view-all">
        {{ section.settings.link_label | default: 'View all' }}
        {% render 'icon-arrow' %}
      </a>
    {%- endif -%}

    <div class="carousel-section__nav">
      <button type="button" data-carousel-prev aria-label="Previous products">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 6 9 12 15 18"></polyline></svg>
      </button>
      <button type="button" data-carousel-next aria-label="Next products">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"></polyline></svg>
      </button>
    </div>
  </div>

  <div class="product-carousel" data-carousel>
    {%- if collection != blank -%}
      {%- for product in collection.products limit: limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Placeholder cards for theme preview before a collection is chosen. {%- endcomment -%}
      {%- for i in (1..4) -%}
        {% render 'product-card' %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (screen-reader only)",
      "default": "Featured products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View all label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Featured collection carousel"
    }
  ]
}
{% endschema %}
