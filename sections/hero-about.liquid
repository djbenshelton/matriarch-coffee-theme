<section class="hero" data-section-id="{{ section.id }}" data-section-type="hero-about">
  <div class="hero__inner container">

    <div class="hero__heading-group">
      {%- if section.settings.eyebrow != blank -%}
        {%- assign eyebrow_words = section.settings.eyebrow | split: ' ' -%}
        {%- assign eyebrow_last = eyebrow_words | last -%}
        {%- assign eyebrow_lead = section.settings.eyebrow | remove: eyebrow_last | strip -%}
        <p class="h2">
          {%- if eyebrow_lead != blank -%}{{ eyebrow_lead }} {%- endif -%}
          <span class="hero__strike">{{ eyebrow_last }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="h1">{{ section.settings.heading }}</h1>
      {%- endif -%}
    </div>

    {%- if section.settings.body != blank -%}
      <div class="hero__copy h4">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.heading_2 != blank or section.settings.eyebrow_2 != blank -%}
      <div class="hero__heading-group">
        {%- if section.settings.heading_2 != blank -%}
          <p class="h1">{{ section.settings.heading_2 }}</p>
        {%- endif -%}
        {%- if section.settings.eyebrow_2 != blank -%}
          <p class="h2">{{ section.settings.eyebrow_2 }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="hero__view-all">
        {{ section.settings.link_label | default: 'View all' }}
        {% render 'icon-arrow' %}
      </a>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Hero / About",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow line",
      "default": "The Art of Coffee"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Crafted With Purpose"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>Discover the essence of bold refinement — where precision, patience, and passion converge in every roast. A curated expression of craftsmanship, created to awaken all senses.</p>"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Second headline",
      "default": "Brewed to Inspire"
    },
    {
      "type": "text",
      "id": "eyebrow_2",
      "label": "Second sub-headline",
      "default": "Defined by Origin"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Hero / About"
    }
  ]
}
{% endschema %}
