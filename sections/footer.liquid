<footer class="site-footer" data-section-id="{{ section.id }}" data-section-type="footer">
  <div class="site-footer__inner">

    <div class="site-footer__columns">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'link_list' -%}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </div>

          {%- when 'newsletter' -%}
            <div class="site-footer__newsletter" {{ block.shopify_attributes }}>
              <div class="site-footer__newsletter-heading">
                <p class="h5">{{ block.settings.heading | default: 'Newsletter' }}</p>
                {% render 'icon-arrow', class: 'icon--rotate-down' %}
                <p class="site-footer__newsletter-copy h6">
                  {{ block.settings.text | default: 'Receive stories of delicious coffees and the latest news.' }}
                </p>
              </div>

              {% form 'customer', class: 'site-footer__newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input
                  type="email"
                  name="contact[email]"
                  placeholder="{{ block.settings.placeholder | default: 'Discount code' }}"
                  required
                >
                <button type="submit">{{ block.settings.button_label | default: 'Register' }}</button>
              {% endform %}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__meta">
      <p>&copy;{{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      <p>{{ section.settings.legal_line | default: 'All rights reserved.' }}</p>
    </div>

  </div>

  {% render 'icon-bolt', class: 'site-footer__mark' %}
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "legal_line",
      "label": "Legal line",
      "default": "All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link list",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Receive stories of delicious coffees and the latest news."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Field placeholder",
          "default": "Enter your email"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Register"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list",
        "settings": { "menu": "footer" }
      },
      {
        "type": "link_list",
        "settings": { "menu": "footer-social" }
      },
      {
        "type": "link_list",
        "settings": { "menu": "footer-legal" }
      },
      {
        "type": "newsletter"
      }
    ]
  }
}
{% endschema %}
